# Telegram-бот
TG_TOKEN=
TG_CHATS=

# Необязательно: принимать запросы только с этих IP
# (если оставить пустым — проверка отключена)
ALLOWED_IPS=

# Необязательно: пути к БД и снимкам
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
SNAPSHOT_DIR=static/snapshots

# Сообщение «Неизвестный человек» для одного gate — не чаще одного раза за этот интервал (секунды)
UNMATCHED_ALERT_DEBOUNCE_SEC=15

# --- Посещаемость (Mini App + Web + бот) ---
SESSION_SECRET=           # длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPERADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_IDS=
PUBLIC_BASE_URL=https://api.ravnaqfarm.uz
BOT_USERNAME=
COOKIE_SECURE=1
DEV_LOGIN=0

# --- Docker / PostgreSQL (docker compose сам собирает из них DATABASE_URL) ---
POSTGRES_DB=ferma
POSTGRES_USER=ferma
POSTGRES_PASSWORD=        # только буквы и цифры: python -c "import secrets; print(secrets.token_hex(16))"
APP_PORT=8085             # приложение открывается на этом порту (nginx/WAF проксирует сюда)
# APP_BIND=127.0.0.1      # если доступ только через nginx на этом же сервере
