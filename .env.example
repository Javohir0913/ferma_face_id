# Telegram bot
TG_TOKEN=
TG_CHATS=

# Ixtiyoriy: faqat shu IP'lardan kelgan so'rovlarni qabul qilish
# (bo'sh qoldirsangiz tekshiruv o'chiq)
ALLOWED_IPS=

# Ixtiyoriy: DB va rasm saqlash yo'llari
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
SNAPSHOT_DIR=static/snapshots

# Bitta gate uchun "Noma'lum odam" xabari shu oraliqda (soniya) faqat bitta marta
UNMATCHED_ALERT_DEBOUNCE_SEC=15

# --- Davomat (Mini App + Web + bot) ---
SESSION_SECRET=           # uzun tasodifiy satr: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPERADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_IDS=
PUBLIC_BASE_URL=https://api.ravnaqfarm.uz
BOT_USERNAME=
COOKIE_SECURE=1
DEV_LOGIN=0

# --- Docker / PostgreSQL (docker compose DATABASE_URL ni o'zi shulardan tuzadi) ---
POSTGRES_DB=ferma
POSTGRES_USER=ferma
POSTGRES_PASSWORD=        # faqat harf va raqam: python -c "import secrets; print(secrets.token_hex(16))"
APP_PORT=8085             # ilova shu portda ochiladi (nginx/WAF shunga proxy qiladi)
# APP_BIND=127.0.0.1      # faqat shu serverdagi nginx orqali kirilsa
